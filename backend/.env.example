# ForestGuard AI Backend Configuration Template
# Copy this file to backend/.env and fill in your private credentials.
# Do NOT commit backend/.env to version control.

# Allowed CORS origins (comma-separated). Add teammates' LAN origins here (e.g. http://192.168.1.50:3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://127.0.0.1:3000

# Optional NASA FIRMS Map Key for active fire proxy
FIRMS_MAP_KEY=

# Server configuration
PORT=8000
HOST=0.0.0.0
